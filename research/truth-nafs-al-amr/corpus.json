{
  "meta": {
    "title": "Truth, Mental Existence & Nafs al-Amr",
    "route": "/research/truth-nafs-al-amr/",
    "status": "Working, source-graded research corpus; see bibliography and per-work evidence",
    "date": "2026-11-13",
    "note": "Bibliographic identification is not a primary-text translation or verification of all claims. Existing translations live in the canonical readers; seven direct Ithbāt commentaries remain awaiting full collation."
  },
  "problems": {
    "P01": "What is the bearer of truth: proposition, judgment, relation, or content?",
    "P02": "What makes a proposition true?",
    "P03": "Why is external existence insufficient?",
    "P04": "Why is mental existence insufficient?",
    "P05": "What does nafs al-amr mean?",
    "P06": "Is nafs al-amr the Active/Separate Intellect?",
    "P07": "Can false judgments be preserved in the truth-ground?",
    "P08": "How can nonexistent or impossible subjects occur in true propositions?",
    "P09": "Do negative propositions require their subjects/predicates to exist?",
    "P10": "How do wāqiʿ, khārij, dhihn, thubūt, ḥaqīqa and nafs al-amr differ?",
    "P11": "How can mathematical objects/models be non-external yet objectively valid?",
    "P12": "Is the ultimate ground divine knowledge, divine essence, a presence, or a rank of reality?",
    "P13": "How does objective truth relate to demonstration and certainty?",
    "P14": "Can objective truth be mind-independent without a self-subsistent third realm?"
  },
  "lineages": {
    "foundation": "Avicenna → Rāzī → Ṭūsī → al-Ḥillī",
