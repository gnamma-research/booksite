    {
      "id": "FG19-063",
      "arabic": "تفرقة",
      "transliteration": "tafriqa",
      "english": "differentiation",
      "editorial_distinction": "Articulated multiplicity related to a rank; often complementary to gathered unity.",
      "category": "Anthropology and journey"
    },
    {
      "id": "FG19-064",
      "arabic": "سلوك",
      "transliteration": "sulūk",
      "english": "spiritual travelling",
      "editorial_distinction": "Ordered travel through stations and practices; distinguish from attraction or sudden disclosure.",
      "category": "Anthropology and journey"
    },
    {
      "id": "FG19-065",
      "arabic": "جذب",
      "transliteration": "jadhb",
      "english": "attraction",
      "editorial_distinction": "Drawing to a rank without the ordinary order of disciplined traversal.",
      "category": "Anthropology and journey"
    },
    {
      "id": "FG19-066",
      "arabic": "تحقيق",
      "transliteration": "taḥqīq",
      "english": "realization",
      "editorial_distinction": "A state of actual realization, not mere theoretical correctness.",
      "category": "Anthropology and journey"
    }
  ]
}
