</script>
<script>
'use strict';
const D=JSON.parse(document.getElementById('edition-data').textContent), U=D.units, N=Object.fromEntries(D.notes.map(n=>[n.id,n])), A=Object.fromEntries(D.apparatus.map(a=>[a.id,a]));
const $=id=>document.getElementById(id), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm=s=>String(s??'').normalize('NFD').replace(/[\u0300-\u036f\u064b-\u065f\u0670\u0640]/g,'').replace(/[أإآ]/g,'ا').toLowerCase();
let saved=new Set(),raw=false,limit=80,filtered=[],timer;try{saved=new Set(JSON.parse(localStorage.getItem('maq-r5-bookmarks')||'[]'));}catch(e){}
let theme='light';try{theme=localStorage.getItem('maq-r5-theme')||'light';}catch(e){}document.documentElement.dataset.theme=theme;$('theme').textContent=theme==='dark'?'Light':'Dark';
$('scope').value='all';if(innerWidth<760)$('tocDetails').open=false;
function toast(t){$('toast').textContent=t;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),2400)}
function grade(u){return u.grade==='critical-r5'?'Source-relative · revision 5':u.grade==='critical-r4'?'Source-relative · revision 4':u.grade==='critical-r3'?'Source-relative · revision 3':u.grade==='critical-r2'?'Prior critical revision 2':u.grade==='terminal-inherited'?'Prior terminal continuation':'Inherited · close review not renewed'}
function inScope(u){const s=$('scope').value;return s==='all'||s==='new'&&u.grade==='critical-r5'||s==='previous'&&['critical-r2','critical-r3','critical-r4'].includes(u.grade)||s==='terminal'&&u.grade==='terminal-inherited'||s==='saved'&&saved.has(u.id)||u.division===s}
function noteButton(id){const n=N[id];return n?`<button class="note" data-note="${esc(id)}">${esc(id)} · ${esc(n.title)}</button>`:''}
function card(u){let arabic=raw?(u.ar_source||u.ar):(u.ar_reading||u.ar);let ns=(u.notes||[]).map(noteButton).join('');if(u.unit_notes_html)ns+=`<button class="inheritednote" data-unit="${esc(u.id)}">Earlier editorial note</button>`;
let aps=(u.apparatus||[]).map(id=>{const a=A[id];return a?`<p><strong>${esc(id)} · ${esc(a.classification)}</strong><br>Transmitted/comparison: <bdi class="ar-inline" lang="ar">${esc(a.source_reading||a.comparison_reading)}</bdi><br>Adopted: <bdi class="ar-inline" lang="ar">${esc(a.adopted_reading)}</bdi><br>${esc(a.reason)}<br><em>${esc(a.basis)}</em></p>`:''}).join('');
return `<article id="${esc(u.id)}" class="${u.kind==='matn'?'matn':''} ${!u.ar?'no-ar':''} ${u.kind==='printer-paratext'?'paratext':''}"><div class="unit-top"><div><div class="unit-id">${esc(u.id)}${u.macro?' · '+esc(u.macro):''}</div><h2 class="unit-title">${esc(u.title)}</h2><span class="badge ${['critical-r2','critical-r3','critical-r4','critical-r5'].includes(u.grade)?'':'inherited'}">${esc(grade(u))}</span><span class="badge">${esc(u.kind==='matn'?'Matn / lemma':u.kind==='printer-paratext'?'Printer’s paratext':u.kind==='inherited'?'Inherited English':'Commentary')}</span><span class="location">${esc(u.location)}</span></div><button class="book" data-book="${esc(u.id)}" aria-label="${saved.has(u.id)?'Remove bookmark':'Bookmark passage'}" aria-pressed="${saved.has(u.id)}">${saved.has(u.id)?'★':'☆'}</button></div><div class="columns"><div class="ar ${arabic?'':'unavailable'}" lang="${arabic?'ar':'en'}" dir="${arabic?'rtl':'ltr'}">${arabic?esc(arabic):'The Arabic for this inherited unit has not been recovered in this package. Its English is preserved, not newly certified.'}</div><div class="en" lang="en">${u.en_html}</div></div>${ns?'<div class="note-row">'+ns+'</div>':''}${aps?'<details class="apparatus"><summary>Textual decisions for this passage</summary>'+aps+'</details>':''}</article>`}
function render(reset=true){if(reset)limit=80;const q=norm($('search').value);filtered=U.filter(u=>inScope(u)&&(!q||norm(u.id+' '+u.title+' '+u.en+' '+u.ar+' '+u.ar_source).includes(q)));const s=$('scope').value;
$('scopeStatus').innerHTML=s==='new'?'<strong>Source-relative continuation · Investigations VII–IX</strong><br>49 source-aligned passages; complete captured Arabic and reversible readings. Earlier English expanded and checked against J14. This does not certify the separate matn or the whole book.':s==='previous'?'<strong>Earlier critical revisions</strong><br>Prophethood I–VI preserved from R2–R4; their existing textual decisions remain separately marked.':s==='terminal'?'<strong>Inherited terminal continuation</strong><br>The ending translation is preserved but not freshly recertified.':'<strong>Cumulative reading edition</strong><br>All recovered inherited material remains, with revised portions clearly labelled. The entire book has NOT yet been fully checked against the Arabic.';
$('count').textContent=`${filtered.length} passages${filtered.length>limit?' · '+Math.min(limit,filtered.length)+' currently displayed':''}`;$('tocCount').textContent='('+filtered.length+')';
$('toc').innerHTML=filtered.map(u=>`<a class="toclink" href="#${esc(u.id)}" data-jump="${esc(u.id)}"><small>${esc(u.id)} · ${u.kind==='matn'?'MATN':u.kind==='printer-paratext'?'PARATEXT':''}</small>${esc(u.title)}</a>`).join('');
$('reader').innerHTML=filtered.length?filtered.slice(0,limit).map(card).join(''):'<div class="empty">No passages match this selection.</div>';$('more').style.display=filtered.length>limit?'block':'none';mode();}
function mode(){document.body.classList.toggle('english-only',$('mode').value==='en');document.body.classList.toggle('arabic-only',$('mode').value==='ar')}
function jump(id){let i=filtered.findIndex(u=>u.id===id);if(i<0){$('scope').value='all';$('search').value='';render();i=filtered.findIndex(u=>u.id===id)}if(i<0)return;if(i>=limit){limit=i+20;render(false)}const el=$(id);if(el){el.scrollIntoView({behavior:'auto',block:'start'});try{history.replaceState(null,'','#'+id)}catch(e){}}}
function dialog(title,content){$('modalTitle').textContent=title;$('modalBody').innerHTML=content;$('modal').showModal();$('modalBody').scrollTop=0}
function showNote(id){const n=N[id];if(!n)return;dialog(n.id+' · '+n.title,n.html+`<p class="meta">${esc(n.basis)}</p>`+(n.targets||[]).map(t=>`<button class="jump" data-jump="${esc(t)}">Go to ${esc(t)}</button>`).join(' '))}
$('reader').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.note)showNote(b.dataset.note);if(b.dataset.unit){const u=U.find(x=>x.id===b.dataset.unit);dialog('Earlier note · '+u.id,u.unit_notes_html)}if(b.dataset.book){const id=b.dataset.book;saved.has(id)?saved.delete(id):saved.add(id);let ok=true;try{localStorage.setItem('maq-r5-bookmarks',JSON.stringify([...saved]))}catch(e){ok=false}b.textContent=saved.has(id)?'★':'☆';b.setAttribute('aria-pressed',saved.has(id));b.setAttribute('aria-label',saved.has(id)?'Remove bookmark':'Bookmark passage');toast(saved.has(id)?(ok?'Bookmark saved':'Bookmark kept for this session; browser storage is unavailable'):'Bookmark removed');if($('scope').value==='saved')render()}});
document.addEventListener('click',e=>{const b=e.target.closest('[data-jump]');if(b){e.preventDefault();if($('modal').open)$('modal').close();jump(b.dataset.jump)}});
$('scope').addEventListener('change',()=>{render();scrollTo({top:0,behavior:'auto'})});$('search').addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>render(),170)});$('mode').addEventListener('change',mode);
$('more').onclick=()=>{limit+=80;render(false)};$('raw').onclick=()=>{raw=!raw;$('raw').setAttribute('aria-pressed',raw);$('raw').textContent=raw?'Established wording':'Source wording';render(false)};
$('noteToggle').onclick=()=>{const hidden=document.body.classList.toggle('notes-hidden');$('noteToggle').textContent=hidden?'Notes off':'Notes on';$('noteToggle').setAttribute('aria-pressed',!hidden)};
$('theme').onclick=()=>{theme=theme==='light'?'dark':'light';document.documentElement.dataset.theme=theme;$('theme').textContent=theme==='dark'?'Light':'Dark';try{localStorage.setItem('maq-r5-theme',theme)}catch(e){}};
$('size').oninput=()=>{document.documentElement.style.setProperty('--en',$('size').value+'px');document.documentElement.style.setProperty('--ar',(Number($('size').value)+4)+'px')};
$('glossary').onclick=()=>dialog('Contextual glossary',`<p class="meta">Contextual glossary including additions from the current revision. Other entries are editorial explanations, not invented dictionary quotations.</p>`+D.glossary.map(g=>`<section class="glossary-entry"><h3><bdi lang="ar" dir="rtl">${esc(g.arabic)}</bdi> · ${esc(g.term)}</h3><strong>${esc(g.rendering)}</strong><p>${esc(g.explanation)}</p><button data-note="${esc(g.note)}">${esc(g.note)}</button></section>`).join(''));
$('modalBody').addEventListener('click',e=>{const b=e.target.closest('[data-note]');if(b){$('modal').close();showNote(b.dataset.note)}});
$('allNotes').onclick=()=>dialog('Explanatory notes',`<p class="meta">49 new notes and preserved notes from prior revisions. Earlier notes retain their original review status.</p>`+[...D.notes].sort((a,b)=>Number(b.id.startsWith('R3-'))-Number(a.id.startsWith('R3-'))).map(n=>`<section><h3>${esc(n.id)} · ${esc(n.title)}</h3>${n.html}<p class="meta">${esc(n.basis)}</p>${(n.targets||[]).map(t=>`<button class="jump" data-jump="${esc(t)}">${esc(t)}</button>`).join(' ')}</section>`).join(''));
$('closeModal').onclick=()=>$('modal').close();$('modal').addEventListener('click',e=>{if(e.target===$('modal'))$('modal').close()});
render();if(location.hash){const id=decodeURIComponent(location.hash.slice(1));if(U.some(x=>x.id===id))jump(id)}
</script></body></html>