<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sharḥ al-Maqāṣid · Critical revision 5</title>
<style>
:root{--bg:#f7f5ef;--paper:#fffefa;--ink:#252f33;--muted:#5e6768;--line:#dcded7;--accent:#12665c;--soft:#eaf2ed;--en:19px;--ar:23px;--shade:#ece8de;color-scheme:light}
:root[data-theme=dark]{--bg:#17201f;--paper:#202a28;--ink:#edece4;--muted:#b3beb8;--line:#43504a;--accent:#8ed0b9;--soft:#273e35;--shade:#344139;color-scheme:dark}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:160px}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,sans-serif}a{color:var(--accent)}button,input,select{font:inherit;color:inherit}button,select,input[type=search]{border:1px solid var(--line);background:var(--paper);border-radius:6px;padding:9px 12px}button{cursor:pointer}button:hover{background:var(--soft)}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.masthead{padding:24px 30px 18px;border-bottom:1px solid var(--line);background:var(--paper)}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:11px;color:var(--accent);font-weight:700}.masthead h1{font:normal 33px Georgia,serif;margin:8px 0}.masthead p{margin:8px 0;color:var(--muted);font-size:14px;max-width:1000px;line-height:1.6}.toolbar{position:sticky;top:0;z-index:5;padding:10px 24px;display:flex;gap:9px;align-items:center;flex-wrap:wrap;background:var(--paper);border-bottom:1px solid var(--line);font-size:13px}.toolbar label{display:flex;gap:5px;align-items:center}.toolbar input[type=search]{min-width:180px;flex:1}.toolbar input[type=range]{width:80px}.shell{display:grid;grid-template-columns:260px minmax(0,1fr);max-width:1760px;margin:auto;gap:26px;padding:22px 26px}.sidebar{align-self:start;position:sticky;top:118px;max-height:calc(100vh - 140px);overflow:auto;font-size:13px}.sidebar summary{font-weight:700;cursor:pointer}.sidebar .toclink{display:block;text-decoration:none;padding:8px 7px;border-bottom:1px solid var(--line);line-height:1.45}.sidebar small{color:var(--muted);display:block;font-size:10px}main{min-width:0}.scope-note{padding:18px 22px;background:var(--soft);border-left:3px solid var(--accent);font-size:14px;line-height:1.7;margin-bottom:22px}.scope-note strong{font-weight:700}.count{color:var(--muted);font-size:12px;margin-bottom:15px}article{background:var(--paper);border:1px solid var(--line);border-radius:8px;margin:0 0 24px;padding:24px 28px;scroll-margin-top:130px}article.matn{border-top:3px solid var(--accent)}article.paratext{border-style:dashed}.unit-top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.unit-id{font:11px ui-monospace,monospace;letter-spacing:.02em;color:var(--muted);overflow-wrap:anywhere}.unit-title{font:normal 22px/1.35 Georgia,serif;margin:10px 0 12px}.badge{display:inline-block;background:var(--soft);font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding:4px 7px;margin-right:6px;border-radius:3px;color:var(--accent)}.badge.inherited{background:var(--shade);color:var(--muted)}.location{font-size:11px;color:var(--muted)}.book{padding:5px 10px;font-size:21px;line-height:1.2}.columns{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;margin:18px 0}.ar{font-family:'Amiri','Noto Naskh Arabic','Geeza Pro','Times New Roman',serif;font-size:var(--ar);line-height:2.05;text-align:right;white-space:pre-wrap;overflow-wrap:break-word}.en{font-family:Georgia,'Times New Roman',serif;font-size:var(--en);line-height:1.78;overflow-wrap:break-word}.en p{margin:0 0 1em}.en h1,.en h2,.en h3{font-family:Georgia,serif;font-size:1.12em}.en ul,.en ol{padding-left:1.3em}.en strong{font-weight:700}.unavailable{font-family:system-ui,sans-serif;font-size:13px;color:var(--muted);font-style:italic;line-height:1.6;direction:ltr;text-align:left;white-space:normal}.english-only .columns,.arabic-only .columns,.no-ar .columns{grid-template-columns:1fr}.english-only .ar{display:none}.arabic-only .en{display:none}.no-ar:not(.arabic-only) .ar{display:none}.note-row{padding-top:12px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:7px;font-size:11px}.note-row button{padding:5px 8px}.notes-hidden .note-row{display:none}.apparatus{margin-top:13px;font-size:12px;line-height:1.7;color:var(--muted)}.apparatus summary{cursor:pointer;color:var(--accent)}.apparatus p{margin:10px 0}.ar-inline{font-family:'Geeza Pro','Times New Roman',serif;direction:rtl;unicode-bidi:isolate;font-size:18px}.source-rule{border-top:1px solid var(--line);padding-top:10px}.load{width:100%;padding:14px;margin-bottom:24px}.footer{font-size:12px;line-height:1.7;color:var(--muted);padding:12px 5px 60px}.footer a{margin-right:14px}dialog{border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink);max-width:850px;width:calc(100% - 32px);max-height:85vh;padding:0}dialog::backdrop{background:#001b18a8}.dialog-head{position:sticky;top:0;background:var(--paper);padding:18px 24px;display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);z-index:1}.dialog-head h2{font:normal 23px Georgia,serif;margin:0}.dialog-body{padding:20px 25px;line-height:1.8;font:17px/1.8 Georgia,serif}.dialog-body h3{font-size:19px;margin-top:28px}.dialog-body p{margin-top:0}.dialog-body .meta{font:12px/1.6 system-ui,sans-serif;color:var(--muted)}.glossary-entry{border-bottom:1px solid var(--line);padding:10px 0}.glossary-entry h3{margin:6px 0}.toast{position:fixed;bottom:15px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:10px 18px;border-radius:6px;z-index:30;font-size:13px}.jump{padding:7px;font-size:12px}.hidden{display:none!important}.empty{padding:45px;background:var(--paper);font-size:16px}#scopeStatus{font-size:13px}#more{display:none}.sr-only{position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden}
@media(max-width:1050px){.shell{grid-template-columns:200px minmax(0,1fr);padding:18px;gap:18px}.columns{gap:22px}article{padding:22px}.toolbar{padding:10px 18px}.masthead{padding:20px}}
@media(max-width:760px){html{scroll-padding-top:220px}.masthead{padding:20px 17px}.masthead h1{font-size:29px}.toolbar{padding:9px 12px;gap:7px;font-size:12px}.toolbar button,.toolbar select,.toolbar input[type=search]{padding:8px}.toolbar input[type=search]{width:100%;min-width:0;flex-basis:100%}.toolbar .size-control{display:none}.shell{display:block;padding:14px 12px}.sidebar{position:static;max-height:none;margin-bottom:18px}.sidebar nav{max-height:240px;overflow:auto}.columns{grid-template-columns:1fr;gap:20px}.ar{padding-bottom:18px;border-bottom:1px solid var(--line)}.english-only .ar{display:none}.arabic-only .ar{border-bottom:0;padding-bottom:0}article{padding:20px 17px}.unit-title{font-size:21px}.scope-note{padding:15px}.dialog-body{padding:18px;font-size:16px}.dialog-head{padding:15px 18px}.unit-id{max-width:235px}.book{font-size:20px}.footer a{display:block;margin:6px 0}}
@media print{.toolbar,.sidebar,.book,.note-row,.masthead p:last-child,.footer,dialog,.load{display:none!important}.shell{display:block;padding:0}.masthead{padding:0 0 15px}article{border:0;border-bottom:1px solid #aaa;padding:15px 0;break-inside:avoid}.columns{gap:24px}.scope-note{background:none}.ar{font-size:17px}.en{font-size:12px}.unit-title{font-size:16px}body{background:#fff;color:#000}}
</style></head><body>
<header class="masthead"><div class="eyebrow">Translations · Critical revision 5 · 4 November 2026</div><h1>Sharḥ al-Maqāṣid <span lang="ar" dir="rtl">شرح المقاصد</span></h1><p>Al-Taftāzānī · bilingual source-relative working edition, with editorial notes, preserved lemma layers where available, and explicit textual decisions.</p><p><strong>Newly revised:</strong> Division VI, Investigations VII–IX (angels, saintly wonders, magic and the evil eye), in 49 source-aligned units. The other sections retain their previous review status; this is not a certified complete critical edition of the six divisions.</p></header>
<div class="toolbar" role="region" aria-label="Reading controls">
<label>Text <select id="scope"><option value="new">New critical revision · Investigations VII–IX</option><option value="previous">Earlier critical revisions · I–VI</option><option value="all">Complete cumulative reading</option><option value="OPEN">Opening</option><option value="C01">Division I</option><option value="C02">Division II</option><option value="C03">Division III</option><option value="C04">Division IV</option><option value="C05">Division V</option><option value="C06">Division VI</option><option value="terminal">Terminal continuation</option><option value="saved">Bookmarks</option></select></label>
<label>View <select id="mode"><option value="both">Arabic + English</option><option value="en">English</option><option value="ar">Arabic</option></select></label>
<input id="search" type="search" placeholder="Search Arabic, English, or passage ID" aria-label="Search the selected text">
<button id="raw" aria-pressed="false" title="Show captured wording instead of the established Arabic reading">Source wording</button><button id="noteToggle" aria-pressed="true">Notes on</button><button id="glossary">Glossary</button><button id="allNotes">All notes</button><button id="theme" aria-label="Toggle light and dark mode">Dark</button>
<label class="size-control">Size <input type="range" id="size" min="16" max="25" value="19" aria-label="Text size"></label>
</div>
<div class="shell"><aside class="sidebar"><details id="tocDetails" open><summary>Contents <span id="tocCount"></span></summary><nav id="toc" aria-label="Passage contents"></nav></details></aside>
<main><section class="scope-note" id="scopeStatus"></section><div id="count" class="count" role="status" aria-live="polite"></div><div id="reader"></div><button id="more" class="load">Load the next passages</button><footer class="footer"><a href="edition/INVESTIGATIONS_VII_IX_UNABRIDGED_WORKING.md">Current bilingual revision</a><a href="edition/CUMULATIVE_ENGLISH_REVIEW_MARKED.md">Cumulative English</a><a href="apparatus/EXPLANATORY_NOTES_R5.md">Explanatory notes</a><a href="apparatus/TEXTUAL_DECISIONS_R5.md">Textual decisions</a><a href="sources/SOURCE_REGISTER_R5.json">Source witness</a><a href="audit/VALIDATION_R5.md">Scope and audit</a><a href="00_START_HERE.md">Edition guide</a><p>The first-pass and terminal translations are preserved but not newly certified. The source and adopted readings are distinguished throughout the revised block. The separate matn remains incomplete.</p></footer></main></div>
<dialog id="modal" aria-labelledby="modalTitle"><div class="dialog-head"><h2 id="modalTitle"></h2><button id="closeModal" aria-label="Close dialog">Close</button></div><div class="dialog-body" id="modalBody"></div></dialog><div id="toast" class="toast hidden" role="status"></div>
<script id="edition-data" type="application/json">